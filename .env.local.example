# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Production values are set in the Vercel project settings (Settings → Environment Variables).

# MongoDB connection string (e.g. from MongoDB Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority

# Secret used to sign login sessions. Use a long random value, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
JWT_SECRET=replace-with-a-long-random-string
